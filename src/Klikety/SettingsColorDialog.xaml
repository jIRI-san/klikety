<Window x:Class="Klikety.SettingsColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose color" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14" ThemeMode="System"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="Padding" Value="0,4,8,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <DrawingBrush x:Key="Checkerboard" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White" Geometry="M 0,0 H 16 V 16 H 0 Z"/>
                    <GeometryDrawing Brush="#D9DDE3" Geometry="M 0,0 H 8 V 8 H 0 Z M 8,8 H 16 V 16 H 8 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="FieldName" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="Choose RGB and opacity, or enter a hex color." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,16"/>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Current" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Background="{StaticResource Checkerboard}">
                    <Border x:Name="OriginalSwatch" Height="64" AutomationProperties.Name="Current color preview"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="New" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Background="{StaticResource Checkerboard}">
                    <Border x:Name="NewSwatch" Height="64" AutomationProperties.Name="New color preview"/>
                </Border>
            </StackPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="64"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>
            <Label Content="_Red" Target="{Binding ElementName=RedValue}"/>
            <Slider x:Name="RedSlider" Grid.Column="1" ValueChanged="ChannelChanged"
                    AutomationProperties.Name="Red" AutomationProperties.AutomationId="color.red.slider"/>
            <TextBox x:Name="RedValue" Grid.Column="2" VerticalAlignment="Center" TextChanged="ChannelTextChanged"
                     AutomationProperties.Name="Red value" AutomationProperties.AutomationId="color.red.value"/>
            <Label Grid.Row="1" Content="_Green" Target="{Binding ElementName=GreenValue}"/>
            <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" ValueChanged="ChannelChanged"
                    AutomationProperties.Name="Green" AutomationProperties.AutomationId="color.green.slider"/>
            <TextBox x:Name="GreenValue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextChanged="ChannelTextChanged"
                     AutomationProperties.Name="Green value" AutomationProperties.AutomationId="color.green.value"/>
            <Label Grid.Row="2" Content="_Blue" Target="{Binding ElementName=BlueValue}"/>
            <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" ValueChanged="ChannelChanged"
                    AutomationProperties.Name="Blue" AutomationProperties.AutomationId="color.blue.slider"/>
            <TextBox x:Name="BlueValue" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" TextChanged="ChannelTextChanged"
                     AutomationProperties.Name="Blue value" AutomationProperties.AutomationId="color.blue.value"/>
            <Label Grid.Row="3" Content="_Opacity" Target="{Binding ElementName=AlphaValue}"/>
            <Slider x:Name="AlphaSlider" Grid.Row="3" Grid.Column="1" ValueChanged="ChannelChanged"
                    AutomationProperties.Name="Opacity" AutomationProperties.AutomationId="color.alpha.slider"/>
            <TextBox x:Name="AlphaValue" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" TextChanged="ChannelTextChanged"
                     AutomationProperties.Name="Opacity value" AutomationProperties.AutomationId="color.alpha.value"/>
        </Grid>
        <TextBlock Text="Values: 0-255. Opacity: 0 = transparent, 255 = opaque."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,12"/>
        <DockPanel>
            <Label Content="_Hex" Width="84" Target="{Binding ElementName=HexValue}"/>
            <TextBox x:Name="HexValue" TextChanged="HexChanged"
                     AutomationProperties.Name="Hex color" AutomationProperties.AutomationId="color.hex"/>
        </DockPanel>
        <TextBlock Text="#RRGGBB or #AARRGGBB (alpha first)." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="84,6,0,0"/>
        <TextBlock x:Name="Status" TextWrapping="Wrap" MinHeight="42" Margin="0,12,0,12"
                   AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="_Cancel" IsCancel="True" Click="CancelClicked"
                    AutomationProperties.Name="Cancel color selection"/>
            <Button x:Name="OkButton" Content="_OK" IsDefault="True" Click="AcceptClicked"
                    AutomationProperties.Name="Use selected color" FontWeight="SemiBold"/>
        </StackPanel>
    </StackPanel>
</Window>
