{
  "$schema": "./.github/skills/autopilot/schemas/autopilot.schema.json",
  "runtime": "container",
  "copilotAuth": "pat",
  "gitProvider": "github",
  "gitAuth": "pat-shared",
  "model": "primary-model-mid",
  "context": "default",
  "reasoningEffort": "medium",
  "git": {
    "name": "your-name",
    "email": "your-email@example.com"
  },
  "maxIterationsPerStep": 10,
  "build": "npm run build",
  "test": "npm test",
  "offlinePackages": { "enabled": false }
}
