<Window x:Class="Klikety.Overlay.MacroPlaybackOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="350" Height="80"
        WindowStartupLocation="CenterScreen">
    <Border Background="#DD222222" CornerRadius="8" Padding="12">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" FontSize="14" FontFamily="Consolas"
                       Foreground="White" TextTrimming="CharacterEllipsis" />
            <Grid Margin="0,6,0,0">
                <ProgressBar x:Name="ProgressBar" Height="12" Minimum="0" Maximum="100" Value="0"
                             Background="#444" Foreground="#4CAF50" />
                <TextBlock x:Name="StepText" FontSize="10" FontFamily="Consolas"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
      <TextBlock x:Name="DelayText"
          FontSize="10"
          FontFamily="Consolas"
                 Foreground="#999"
          Margin="0,4,0,0"
          Visibility="Collapsed"/>
    </StackPanel>
    </Border>
</Window>
