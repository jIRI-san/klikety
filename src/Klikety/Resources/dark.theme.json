{
  // Klikety Dark Theme
  // JSON with Comments (JSONC)
  "$schema": "theme.schema.json",

  // Label text
  "labelFontFamily": "Segoe UI",    // Font family for cell labels
  "labelFontSize": 14.0,            // Font size in points
  "labelColor": "#FFFFFF",          // White text on dark background
  "labelFontWeight": "Normal",      // Normal weight
  "labelOutlineColor": "#000000", // Black outline for contrast
  "labelOutlineThickness": 1.5, // Outline stroke width

  // Cell borders
  "cellBorderColor": "#555555",     // Medium gray borders
  "cellBorderThickness": 1.0,       // 1px borders

  // Normal cell background
  "cellBackgroundColor": "#000000", // Black background
  "cellBackgroundOpacity": 0.2, // Semi-transparent

  // Dimmed cells (non-matching after first key)
  "dimmedOverlayColor": "#000000",  // Black overlay
  "dimmedOverlayOpacity": 0.4, // Fairly opaque dimming

  // Highlighted column (matching column after first key)
  "highlightedColumnBackground": "#FFCC00",    // Gold highlight
  "highlightedColumnBorderColor": "#FFCC00",   // Matching gold border

  // Subgrid (level 2/3) distinct styling
  "subgridBorderColor": "#00AAFF",  // Blue borders for subgrid
  "subgridLabelColor": "#00CCFF",   // Cyan labels for subgrid

  // External labels (when cells too small for inline labels)
  "externalColLabelColor": "#FFCC00", // Gold external column labels
  "externalRowLabelColor": "#66CCFF", // Blue row external labels
  "connectorLineColor": "#FFCC00",  // Gold connector lines
  "connectorLineThickness": 1.0, // 1px connector lines
  // LogGrid small-cell tint
  "smallCellBackgroundColor": "#1A4A7A", // Dark blue tint for small cells
  "smallCellBackgroundOpacity": 0.5, // Semi-transparent

  // App-scope visual indicator
  "appScopeBorderColor": "#4488FF" // Blue accent border when app-scoped
}
