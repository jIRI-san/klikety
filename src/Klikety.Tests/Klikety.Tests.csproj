<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klikety\Klikety.csproj" />
    <ProjectReference Include="..\Klikety.WorkerFixture\Klikety.WorkerFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyWorkerFixtures" AfterTargets="Build">
    <ItemGroup>
      <WorkerFixtureFiles Include="..\Klikety.WorkerFixture\bin\$(Configuration)\$(TargetFramework)\*" />
      <BundledWorkerFiles Include="..\Klikety\bin\$(Configuration)\$(TargetFramework)\uia-worker\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerFixtureFiles)" DestinationFolder="$(TargetDir)worker-fixture" />
    <Copy SourceFiles="@(BundledWorkerFiles)" DestinationFolder="$(TargetDir)uia-worker" />
  </Target>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\Klikety.UiaWorker\UiaTreeAlgorithms.cs" Link="UiaTreeAlgorithms.cs" />
  </ItemGroup>

</Project>
