{
  // Klikety Configuration
  // JSON with Comments (JSONC) — comments are stripped when loaded.
  // Schema provides IntelliSense in editors that support it.
  "$schema": "config.schema.json",

  // Global hotkey that activates the navigation overlay.
  // Modifiers: Alt, Control, Shift, Win (comma-separated for combos).
  // Key: a VKey name (physical key, layout-independent). Default: Alt+Space.
  "hotKey": {
    "modifiers": "Alt",
    "key": "Space"
  },

  // Maps VKey names to mouse actions.
  // Space → LeftClick is always the implicit default even if omitted.
  // Available actions: LeftClick, RightClick, MiddleClick, DoubleClick, MoveOnly, DragDrop.
  "actionBindings": {
    "X": "DoubleClick",
    "C": "MiddleClick",
    "V": "RightClick",
    "B": "MoveOnly",
    "Z": "DragDrop"
  },

  // VKey lists for axis navigation. Shared by all modes.
  // Horizontal keys select a column, vertical keys select a row.
  "horizontalKeys": [
    "A",
    "S",
    "D",
    "F",
    "G",
    "H",
    "J",
    "K",
    "L",
    "OemSemicolon"
  ],
  "verticalKeys": [
    "Q",
    "W",
    "E",
    "R",
    "T",
    "Y",
    "U",
    "I",
    "O",
    "P"
  ],

  // Physical pixel² area threshold for level-3 auto-activation.
  // When a level-2 cell exceeds this area, a third navigation level becomes available.
  // Default 0 = always active. Set higher to disable L3 on small cells.
  "level3CellSizeThreshold": 0,

  // Minimum log level written to %APPDATA%\Klikety\logs\.
  // Values: Trace, Debug, Information, Warning, Error, Critical, None.
  "logLevel": "Debug",

  // Enable file logging. When false, no log folder is created.
  "fileLoggingEnabled": true,

  // Maximum number of rolling log files to keep. Oldest deleted when exceeded.
  "retainedLogFileCount": 7,

  // Navigation modes. Each mode can be independently enabled/disabled.
  // Exactly one mode must be marked "default": true.
  // N and M are default chord keys — do not use in action bindings.
  "modes": {
    "uniformGrid": {
      "enabled": true,
      "default": true,
      "arrowKeys": true,
      "twoKey": true
    },
    "crosshair": {
      "enabled": true,
      "chordKey": "N",
      "arrowKeys": true,
      "twoKey": true
    },
    "logCrosshair": {
      "enabled": true,
      "chordKey": "M",
      "arrowKeys": true,
      "twoKey": true,
      "logBaseSize": 10
    },
    "logGrid": {
      "enabled": true,
      "chordKey": "OemComma",
      "arrowKeys": true,
      "twoKey": true,
      "logGridBaseSize": 10
    }
  },

  // Config format version. Do not change manually.
  "configVersion": 3,

  // Global scroll hotkeys. Send mouse wheel events at current cursor position.
  // Disabled by default. Keys: Ctrl+Alt+PageUp (up), Ctrl+Alt+PageDown (down).
  "scrollHotkeys": {
    "enabled": false,
    "scrollUpKey": {
      "modifiers": "Control, Alt",
      "key": "Prior"
    },
    "scrollDownKey": {
      "modifiers": "Control, Alt",
      "key": "Next"
    },
    "scrollAmount": 3
  },

  // Theme: bare name (resolves to themes/<name>.theme.json) or relative path.
  // Built-in themes: "dark", "light".
  "theme": "dark",

  // Minimum label font size in DIP. When subgrid cells are too small for labels
  // at this size, labels render outside the grid with connector lines.
  "minLabelFontSize": 14.0
}
